# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다.

# PostgreSQL (compose.yaml과 백엔드가 함께 사용)
# 비밀번호는 여기 한 곳에만 쓴다. 접속 주소는 백엔드가 이 값들로 만든다.
# DB를 처음 띄운 뒤 비밀번호를 바꾸면 반영되지 않는다 (docker compose down -v 후 다시 띄워야 함, 개발 데이터 삭제됨).
POSTGRES_USER=capston
POSTGRES_PASSWORD=
POSTGRES_DB=capston
# 공용 개발 DB(AWS)는 EC2의 Tailscale 주소, 로컬 개발 DB는 localhost. 테스트는 이 값과 무관하게 로컬 테스트 DB를 쓴다.
POSTGRES_HOST=localhost

# Ollama 주소. 개발은 자기 PC(http://localhost:11434), AWS 백엔드는 LLM PC의 Tailscale 주소
OLLAMA_BASE_URL=http://localhost:11434

# KIS 모의투자 (실전투자 키는 두지 않는다)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호 앞 8자리
KIS_ACCOUNT_NO=
# 계좌 상품코드 뒤 2자리 (주식 종합계좌는 01)
KIS_ACCOUNT_PRODUCT_CODE=01

# KRX Open API
KRX_API_KEY=
