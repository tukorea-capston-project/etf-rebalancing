# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다.

# PostgreSQL (compose.yaml과 백엔드가 함께 사용)
# 비밀번호는 여기 한 곳에만 쓴다. 접속 주소는 백엔드가 이 값들로 만든다.
# 팀원 PC의 비밀번호는 서비스 DB(EC2)의 비밀번호와 같아야 개발 서버가 서비스 DB에 붙는다.
POSTGRES_USER=capston
POSTGRES_PASSWORD=
POSTGRES_DB=capston
# 서비스 DB(EC2)는 EC2의 Tailscale 주소. 머지 전 스키마 변경을 확인할 때는 localhost + POSTGRES_PORT=15433(테스트 DB).
# 테스트는 이 값과 무관하게 로컬 테스트 DB를 쓴다.
POSTGRES_HOST=localhost

# Ollama 주소. 개발은 자기 PC(http://localhost:11434), EC2 백엔드는 LLM PC의 Tailscale 주소
OLLAMA_BASE_URL=http://localhost:11434

# 실전투자 서버 스위치. EC2에서만 true로 켠다. 팀원 PC는 항상 false.
REAL_TRADING_ENABLED=false

# KIS 앱키·시크릿·계좌번호는 여기 두지 않는다. 사용자별로 등록받아 DB에 암호화해 저장한다.
# 암호화 마스터키: 팀원 PC는 local(CREDENTIAL_LOCAL_KEY), EC2는 kms(KMS_KEY_ID)
# REAL_TRADING_ENABLED=true는 kms일 때만 허용된다.
CREDENTIAL_KEY_PROVIDER=local
CREDENTIAL_LOCAL_KEY=
KMS_KEY_ID=

# KRX Open API
KRX_API_KEY=

# 한국은행 ECOS
ECOS_API_KEY=

# 공공데이터포털
KOFIA_API_KEY=